// -------------------------------------
// g - maghreb numbers 

default partial alphanumeric_keys 
xkb_symbols "g" {
	name[Group1]= "simplified arabic, maghreb";

    key <TLDE> { [ grave,	asciitilde	] };
    key <AE01> { [ 1,		exclam		] };
    key <AE02> { [ 2,		at		] };
    key <AE03> { [ 3,		numbersign	] };
    key <AE04> { [ 4,		dollar		] };
    key <AE05> { [ 5,		percent		] };
    key <AE06> { [ 6,		asciicircum	] };
    key <AE07> { [ 7,		ampersand	] };
    key <AE08> { [ 8,		asterisk	] };
    key <AE09> { [ 9,		parenright	] };
    key <AE10> { [ 0,		parenleft, degree	] };
    key <AE11> { [ minus,	underscore, Arabic_tatweel	] };
    key <AE12> { [ equal,	plus		] };

    key <AD01> { [ Arabic_dad,	Arabic_damma	] };
    key <AD02> { [ Arabic_sad,	Arabic_dammatan	] };
    key <AD03> { [ Arabic_kaf,	Arabic_kasra	] };
    key <AD04> { [ Arabic_qaf,	Arabic_fathatan	] };
    key <AD05> { [ Arabic_feh,	Arabic_fatha, U06A2  ] };
    key <AD06> { [ Arabic_ha,	Arabic_maddaonalef  ] };
    key <AD07> { [ Arabic_ain,	Arabic_ghain	]};
    key <AD08> { [ Arabic_hah,	Arabic_khah	] };
    key <AD09> { [ Arabic_jeem,	VoidSymbol	] };
    key <AD10> { [ Arabic_dal,	Arabic_thal	] };
    key <AD11> { [ bracketright, braceright	] };
    key <AD12> { [ bracketleft,	braceleft	] };

    key <AC01> { [ Arabic_sheen, Arabic_shadda	] };
    key <AC02> { [ Arabic_seen,	Arabic_sukun	] };
    key <AC03> { [ Arabic_yeh,	Arabic_kasratan	] };
    key <AC04> { [ Arabic_beh, 	VoidSymbol 	] };
    key <AC05> { [ Arabic_lam,	VoidSymbol	] };
    key <AC06> { [ Arabic_alef,	Arabic_hamzaonalef	] };
    key <AC07> { [ Arabic_teh,	Arabic_tatweel  ] };
    key <AC08> { [ Arabic_noon,	VoidSymbol	] };
    key <AC09> { [ Arabic_meem,	VoidSymbol	] };
    key <AC10> { [ Arabic_semicolon, colon, semicolon] };
    key <AC11> { [ apostrophe, quotedbl, acute, dead_acute ] };

    key <LSGT> { [ bar,		brokenbar	] };
    key <AB01> { [ Arabic_hamza, VoidSymbol	] };
    key <AB02> { [ Arabic_tah,	Arabic_zah] };
    key <AB03> { [ Arabic_alefmaksura,	Arabic_hamzaonyeh	] };
    key <AB04> { [ Arabic_ra,	Arabic_zain	] };
    key <AB05> { [ Arabic_theh,	VoidSymbol  	] };
    key <AB06> { [ Arabic_tehmarbuta,	Arabic_hamzaunderalef	] };
    key <AB07> { [ Arabic_waw,	Arabic_hamzaonwaw] };
    key <AB08> { [ Arabic_comma, less,	comma	] };
    key <AB09> { [ period,	greater		] };
    key <AB10> { [ slash,	Arabic_question_mark	] };
   
   key <BKSL> { [ backslash,	bar	] };
   include "level3(ralt_switch)"
};


// ------------------------------------
// c - machriq numbers 

partial alphanumeric_keys modifier_keys
xkb_symbols "c" {
	include "ars(g)"
    name[Group1]= "simplified arabic, machriq";

    key <TLDE> { [ grave,	asciitilde	] };
    key <AE01> { [ Arabic_1,	exclam,		1	] };
    key <AE02> { [ Arabic_2,	at,			2	] };
    key <AE03> { [ Arabic_3,	numbersign,	3	] };
    key <AE04> { [ Arabic_4,	dollar,		4	] };
    key <AE05> { [ Arabic_5,	percent,	5	] };
    key <AE06> { [ Arabic_6,	asciicircum,6	] };
    key <AE07> { [ Arabic_7,	ampersand,	7	] };
    key <AE08> { [ Arabic_8,	asterisk,	8	] };
    key <AE09> { [ Arabic_9,	parenright,	9	] };
    key <AE10> { [ Arabic_0,	parenleft,	0, degree	] };
    key <AE11> { [ minus,	underscore, Arabic_tatweel	] };
    key <AE12> { [ equal,	plus		] };

    include "level3(ralt_switch)"
};

